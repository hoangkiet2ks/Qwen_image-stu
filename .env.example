# Copy this file to .env and adjust values for your setup

# Proxy server port
PORT=3000

# ComfyUI connection
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188

# ComfyUI input/output directories (Windows path)
COMFYUI_INPUT_DIR=C:/ComfyUI_windows_portable/ComfyUI/input
COMFYUI_OUTPUT_DIR=C:/ComfyUI_windows_portable/ComfyUI/output
